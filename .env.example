# ACARE Root Environment Example
# Copy this file to .env or use the respective apps/api/.env.example and apps/web/.env.example

# Backend API
MONGO_URI=mongodb://localhost:27017
MONGODB_DB_NAME=acare-mvp
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=12

# Frontend (the code reads VITE_API_URL — see apps/web/src/lib/api.ts)
VITE_API_URL=http://localhost:8000
