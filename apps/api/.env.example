MONGO_URI=mongodb://localhost:27017
MONGODB_DB_NAME=acare-mvp
SECRET_KEY=super-secret-key-change-in-prod-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=12
ENABLE_INDIVIDUAL_FISH_TRACKING=false
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DATA_ENTRY=60/minute
RATE_LIMIT_ADMIN=30/minute

# --- Firebase Cloud Messaging (Android push) --------------------------------
# Optional. Leave both unset and push is a no-op: the in-app notification feed
# is unaffected and the API behaves exactly as it did before push existed.
#
# Set ONE of these to the service-account key from
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# This credential can send as your Firebase project — never commit it, and never
# ship it in the APK (google-services.json is the client half, and is not secret).
#
# FCM_SERVICE_ACCOUNT_FILE is the sane option locally; FCM_SERVICE_ACCOUNT_JSON
# takes the whole file inline as one value, which is what Render can hold.
# See apps/web/ANDROID.md for the full setup.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
# Must match CHANNEL_ID in apps/web/src/lib/push.ts and
# default_notification_channel_id in the Android strings.xml — Android 8+ drops
# a message naming a channel that does not exist, with no error anywhere.
FCM_ANDROID_CHANNEL_ID=acare-alerts

# --- Over-the-air web bundles (Android) -------------------------------------
# The APK is a WebView around apps/web, so frontend changes reach installed
# tablets as a downloaded bundle instead of a reinstalled APK. See
# apps/web/ANDROID.md and app/routers/app_updates.py.
#
# Leave APP_UPDATE_TOKEN unset and publishing is closed: /app-updates/bundles
# returns 503, so a deployment nobody has given the secret to cannot have its
# update pointer rewritten. The device-facing check endpoint still works and
# simply reports "up to date".
#
# Must match the APP_UPDATE_TOKEN secret in the GitHub repository settings, which
# is what CI presents as the X-Update-Token header.
APP_UPDATE_TOKEN=
# Kill switch. Set false to halt OTA delivery fleet-wide without redeploying the
# app or deleting any bundle; devices keep whatever they are running.
APP_UPDATE_ENABLED=true
# Per-IP, and a whole facility can share one NAT address.
RATE_LIMIT_APP_UPDATE_CHECK=120/minute
