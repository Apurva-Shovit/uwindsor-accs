<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- The system bars have to be coloured twice, because the two Android
             generations get there by different routes:

             API 35+ enforces edge-to-edge, so StatusBar.setBackgroundColor() is
             a no-op and Capacitor's SystemBars plugin paints the bar areas with
             the theme's windowBackground.

             API < 35 (this app's minSdk is 24) draws the bars as separate
             regions from statusBarColor/navigationBarColor, and windowBackground
             never reaches them. Without these two, the parent AppCompat theme's
             platform default — black — wins. -->
        <item name="android:windowBackground">@color/systemBarBackground</item>
        <item name="android:statusBarColor">@color/systemBarBackground</item>
        <item name="android:navigationBarColor">@color/systemBarBackground</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/systemBarBackground</item>
        <!-- Matched to AppTheme.NoActionBar so the bars do not flash black
             during the splash and then change colour. -->
        <item name="android:statusBarColor">@color/systemBarBackground</item>
        <item name="android:navigationBarColor">@color/systemBarBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
