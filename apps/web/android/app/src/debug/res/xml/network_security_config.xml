<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Permits plain HTTP so a debug APK can talk to a FastAPI dev
  server on the local network. The release build never sees this file, so it
  keeps Android's default of blocking cleartext outright.

  10.0.2.2 is the host machine as seen from the Android emulator. The private
  ranges cover a physical device on the same Wi-Fi as the dev machine.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.190.22.209</domain>
    </domain-config>
</network-security-config>
